# Database
DATABASE_URL="postgresql://user:password@localhost:5432/emprendedor?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"

# Site Configuration
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Conekta Payment Integration (Optional)
CONEKTA_PRIVATE_KEY="key_your_private_key"
NEXT_PUBLIC_CONEKTA_PUBLIC_KEY="key_your_public_key"

# Cloudflare Stream / Video Upload (Optional)
CF_STREAM_CUSTOMER_CODE="your_customer_code"
CF_STREAM_API_TOKEN="your_api_token"

# Email Service - Resend (Optional)
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Currency (Optional)
CURRENCY="MXN"
