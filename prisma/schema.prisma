// Prisma Schema para Plataforma de Cursos "¿Eres Emprendedor?"
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USUARIOS Y PERFILES
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  enrollments   Enrollment[]
  progress      Progress[]
  certificates  Certificate[]
  orders        Order[]
  badges        UserBadge[]
  accounts      Account[]
  sessions      Session[]

  @@index([email])
  @@map("users")
}

enum Role {
  USER
  MENTOR
  ADMIN
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  avatarUrl   String?
  country     String?
  phone       String?
  linkedinUrl String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("profiles")
}

// NextAuth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// CURSOS Y CONTENIDO
// ============================================

model Course {
  id                   String          @id @default(cuid())
  slug                 String          @unique
  title                String
  subtitle             String?
  level                Int             // 1-4
  priceCents           Int             // precio en centavos
  currency             String          @default("MXN")
  status               CourseStatus    @default(DRAFT)

  heroImageUrl         String?
  certificateTemplate  String?
  valueProps           Json?           // array de value propositions

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  modules              Module[]
  activities           Activity[]
  enrollments          Enrollment[]
  products             Product[]
  sessionsOffers       SessionOffer[]
  certificates         Certificate[]
  orders               Order[]

  @@index([slug])
  @@index([status])
  @@index([level])
  @@map("courses")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

model Module {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  index           Int
  title           String
  description     String?  @db.Text
  durationMinutes Int?
  isFreePreview   Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lessons         Lesson[]

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id              String   @id @default(cuid())
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  index           Int
  title           String
  description     String?  @db.Text
  videoUrl        String?
  transcriptUrl   String?
  downloadableUrls Json?   // array de URLs de archivos descargables

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  progress        Progress[]

  @@index([moduleId])
  @@map("lessons")
}

model Activity {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?      @db.Text
  type        ActivityType
  config      Json?        // configuración específica por tipo

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([courseId])
  @@map("activities")
}

enum ActivityType {
  CHALLENGE
  QUIZ
  UPLOAD
}

// ============================================
// PROGRESO Y CERTIFICADOS
// ============================================

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status          EnrollmentStatus @default(TRIAL)
  accessExpiresAt DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

enum EnrollmentStatus {
  TRIAL
  ACTIVE
  COMPLETED
  REFUNDED
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completed   Boolean   @default(false)
  completedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("progress")
}

model Certificate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  code      String   @unique
  pdfUrl    String?
  issuedAt  DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}

// ============================================
// PAGOS Y PRODUCTOS
// ============================================

model Product {
  id             String  @id @default(cuid())
  courseId       String
  course         Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  stripePriceId  String? @unique
  paypalPlanId   String?
  conektaPlanId  String? // ID del plan en Conekta (opcional)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([courseId])
  @@map("products")
}

model Order {
  id                     String      @id @default(cuid())
  userId                 String
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId               String
  course                 Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  stripePaymentIntentId  String?     @unique
  paypalOrderId          String?     @unique
  conektaOrderId         String?     @unique
  status                 OrderStatus @default(REQUIRES_PAYMENT)
  amountCents            Int
  currency               String      @default("MXN")

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("orders")
}

enum OrderStatus {
  REQUIRES_PAYMENT
  PAID
  REFUNDED
  FAILED
}

// ============================================
// SESIONES Y MENTORÍA
// ============================================

model SessionOffer {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tier     Int    // 1-4
  minutes  Int    // duración de cada sesión
  count    Int    // cantidad de sesiones incluidas

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@map("sessions_offers")
}

model MentoringSlot {
  id           String   @id @default(cuid())
  mentorUserId String

  startTs      DateTime
  endTs        DateTime
  isBooked     Boolean  @default(false)
  bookingUrl   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([mentorUserId])
  @@index([startTs])
  @@map("mentoring_slots")
}

// ============================================
// INVERSIONISTAS
// ============================================

model Investor {
  id           String  @id @default(cuid())
  name         String
  thesis       String? @db.Text
  ticketMin    Int?
  contactEmail String
  isActive     Boolean @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("investors")
}

// ============================================
// WEBHOOKS
// ============================================

model Webhook {
  id        String   @id @default(cuid())
  source    String   // "stripe", "paypal", "conekta", "calendly"
  eventType String
  payload   Json
  processed Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([source])
  @@index([processed])
  @@map("webhooks")
}

// ============================================
// INSIGNIAS Y GAMIFICACIÓN
// ============================================

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String?     @db.Text
  icon        String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}
